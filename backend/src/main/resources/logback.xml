<?xml version="1.0" encoding="UTF-8"?>
<configuration>
    <!-- Console appender for logging with colored output -->
    <appender name="CONSOLE" class="ch.qos.logback.core.ConsoleAppender">
        <encoder>
            <!-- Default pattern with colors for different packages -->
            <pattern>
               %cyan(%d{yyyy-MM-dd HH:mm:ss.SSS}) [%thread] %highlight(%-5level) %yellow(%logger{36}) - %magenta(%msg) %n
            </pattern>
        </encoder>
    </appender>

    <!-- Root logger for global logging -->
    <root level="INFO">
        <appender-ref ref="CONSOLE"/>
    </root>


    <!-- Custom logger for controllers with DEBUG level -->
    <logger name="com.ebilling.controllers" level="INFO">
        <appender-ref ref="CONSOLE"/>
    </logger>


    <!-- Reduce log level for Spring, Hibernate, and Tomcat to minimize output -->
    <logger name="org.springframework" level="WARN"/>
    <logger name="org.hibernate" level="WARN"/>
    <logger name="org.hibernate.SQL" level="WARN"/>
    <logger name="org.hibernate.orm.jdbc.bind" level="WARN"/>
    <logger name="org.hibernate.orm.jdbc.warn" level="ERROR"/>
    <logger name="org.hibernate.stat" level="WARN"/>
    <logger name="liquibase" level="INFO"/>
    <logger name="org.apache" level="WARN"/>
    <logger name="com.zaxxer.hikari" level="WARN"/>

    <!-- DEBUG level for your application code -->
    <logger name="com.ebilling" level="INFO"/>
    <logger name="com.ebilling.services" level="DEBUG"/>
    <logger name="com.ebilling.repositories" level="WARN"/>
</configuration>
