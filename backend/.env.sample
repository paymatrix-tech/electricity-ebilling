# PostgreSQL
JDBC_URL=jdbc:postgresql://localhost:5432/electricity_ebilling
DB_USERNAME=ebilling
DB_PASSWORD=ebilling

# Mail
MAIL_USERNAME=your_email@example.com
MAIL_PASSWORD=your_email_password
MAIL_HOST=smtp.example.com
MAIL_PORT=587

# JWT (use a strong secret, 32+ characters)
JWT_SECRET=change_me_to_a_long_random_secret
JWT_EXPIRES_IN=3600

# Encryption (UPI / sensitive fields)
APP_ENCRYPTION_KEY=01234567890123456789012345678901
APP_IV_KEY=0123456789012345

# UPI ID that receives bill payments
BILLING_RECEIVER_UPI_ID=billing@upi

SPRING_PROFILES_ACTIVE=local

# Local: false = skip SMTP (OTP in server log; UPI/invoice emails not sent). Production: true + real MAIL_*.
APP_MAIL_ENABLED=false

# Liquibase dev seed (local profile, context seed-dev) — admin user email/phone
# SEED_ADMIN_EMAIL=you@example.com
# SEED_ADMIN_PHONE=9000000000

# Production only (SPRING_PROFILES_ACTIVE=prod): comma-separated frontend origins
# CORS_ALLOWED_ORIGINS=https://your-app.example.com
